<?xml version="1.0"?>
<ruleset name="Brain 2FA">
	<description>WordPress Coding Standards for Brain 2FA.</description>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<file>brain-2fa.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>assets/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- WooCommerce capabilities that decide who uses the My Account Login Security tab. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="view_admin_dashboard"/>
			</property>
		</properties>
	</rule>

	<!-- PHP 8.1+ compatibility (uses testVersion above). -->
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
